{{!
    @template block_rajabsgames/levelblock

    The levels section of the course block: a heading and the course's levels, marking the reached and the next one.

    Context variables required for this template:
    * haslevel - whether the section is shown
    * levels - array of levels, see block_rajabsgames/level

    Example context (json):
    {
        "haslevel": true,
        "levels": [
            {"id": 1700000101, "name": "Beginner", "order": 1, "xp": 10, "completed": true, "current": false, "isblock": true},
            {"id": 1700000102, "name": "Expert", "order": 2, "xp": 50, "completed": false, "current": true, "isblock": true}
        ]
    }
}}
{{#haslevel}}
<div class="rg_levels">
    <h5 class="d-flex align-items-center justify-content-between section-header">
        <span class="rg_section_label iv-rounded-0 border-0 alert alert-success m-0 text-success">{{#str}}levels, block_rajabsgames{{/str}}</span>
        <span class="rg_section_icon text-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bar-chart-fill" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z"/>
            </svg>
        </span>
    </h5>
    <div role="list" class="rg_level_list p-0">
        {{< block_rajabsgames/level}}{{$itemrole}}role="listitem"{{/itemrole}}{{/block_rajabsgames/level}}
        {{^levels}}
        <div role="listitem" class="text-muted w-100 text-center my-5 empty-message">{{#str}}nolevels, block_rajabsgames{{/str}}</div>
        {{/levels}}
    </div>
</div>
{{/haslevel}}
