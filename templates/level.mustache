{{!
    @template block_rajabsgames/level

    One list item per level: the block's level list, or the block configuration form (with edit and delete buttons).

    Each item carries the plugin's scoping class itself, because block_main renders the list alone
    and replaces the items of an existing list. As for block_rajabsgames/badge, the item is a div and
    the templates whose list holds it set the itemrole block to the listitem role.

    Context variables required for this template:
    * levels - array of levels: id, name, order, xp (threshold), completed, current (the next level
      to reach), isblock (read-only rendering)

    Example context (json):
    {
        "levels": [
            {"id": 1700000101, "name": "Beginner", "order": 1, "xp": 10, "completed": true, "current": false, "isblock": true},
            {"id": 1700000102, "name": "Expert", "order": 2, "xp": 50, "completed": false, "current": true, "isblock": true}
        ]
    }
}}
{{#levels}}
<div {{$itemrole}}{{/itemrole}} class="block-rajabsgames rg_level_item iv-mb-2 d-inline-flex flex-column align-items-center iv-rounded-lg {{#current}}rg_level_current{{/current}}{{^current}}bg-light{{/current}} p-2 mb-1 justify-content-between" data-id="{{id}}">
    <div class="d-flex flex-column align-items-center w-100">
        <div class="rg_level_icon {{#completed}}completed bg-success{{/completed}} {{#current}}current bg-primary{{/current}}">
            {{#completed}}<i class="fa fa-check" aria-hidden="true"></i>{{/completed}}{{^completed}}{{order}}{{/completed}}
        </div>
        <span class="rg_level_name py-2 px-1 w-100 {{#isblock}}text-truncate{{/isblock}} text-center" title="{{name}}">{{name}}</span>
        <span class="rg_level_xp text-muted small iv-font-weight-light">{{xp}} <sup>{{#str}}xp, block_rajabsgames{{/str}}</sup></span>
    </div>
    {{^isblock}}
    <div class="actions">
        <button class="btn btn-sm iv-mr-1 edit-level"
                data-id="{{id}}"
                type="button"
                title="{{#str}}editlevel, block_rajabsgames{{/str}}"
                aria-label="{{#str}}editlevel, block_rajabsgames{{/str}}">
            <i class="fa fa-edit" aria-hidden="true"></i>
        </button>
        <button class="btn btn-sm text-danger delete-level"
                data-id="{{id}}"
                type="button"
                title="{{#str}}deletelevel, block_rajabsgames{{/str}}"
                aria-label="{{#str}}deletelevel, block_rajabsgames{{/str}}">
            <i class="fa fa-trash" aria-hidden="true"></i>
        </button>
    </div>
    {{/isblock}}
</div>
{{/levels}}
