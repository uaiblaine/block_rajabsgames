{{!
    @template block_rajabsgames/form

    The levels and badges editor inside the block's configuration form, with its add, edit and delete buttons.

    The buttons are wired by block_rajabsgames/block_main. On the course page the block's own
    get_required_javascript() has already initialised it; on the standalone edit page (admin layout,
    where the block itself is not rendered) only this template's call does. init() runs once per page,
    so the second call on the course page is a no-op.

    Context variables required for this template:
    * levels - array of levels, see block_rajabsgames/level
    * badges - array of badges, see block_rajabsgames/badge
    * usedbadges - whether some badge is placed in a video, which locks its deletion
    * blockid, contextid, courseid, userid - ids passed to block_main's init()

    Example context (json):
    {
        "levels": [
            {"id": 1700000101, "name": "Beginner", "order": 1, "xp": 10},
            {"id": 1700000102, "name": "Expert", "order": 2, "xp": 50}
        ],
        "badges": [
            {
                "id": 1700000001,
                "name": "Explorer",
                "picture": "https://moodle.example/pluginfile.php/27/block_rajabsgames/content/0/explorer.png",
                "used": true
            }
        ],
        "usedbadges": true,
        "blockid": 27,
        "contextid": 120,
        "courseid": 4,
        "userid": 2
    }
}}
<div class="block-rajabsgames block-rajabsgames-config">
<div class="rg_levels mb-3">
    <h5 class="text-gray d-flex align-items-center justify-content-between section-header">
        <span class="d-flex align-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bar-chart-fill" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z"/>
            </svg>
            <span class="iv-ml-2">{{#str}}levels, block_rajabsgames{{/str}}</span>
        </span>
        <button class="btn btn-sm btn-light" id="add-level" type="button" title="{{#str}}addlevel, block_rajabsgames{{/str}}">
            <i class="fa fa-plus iv-mr-2" aria-hidden="true"></i>{{#str}}addlevel, block_rajabsgames{{/str}}
        </button>
    </h5>
    <div role="list" class="rg_level_list p-0">
        {{< block_rajabsgames/level}}{{$itemrole}}role="listitem"{{/itemrole}}{{/block_rajabsgames/level}}
        {{^levels}}
        <div role="listitem" class="text-muted w-100 text-center my-5 empty-message">{{#str}}nolevels, block_rajabsgames{{/str}}</div>
        {{/levels}}
    </div>
</div>
<div class="rg_badges mb-4">
    <h5 class="text-gray d-flex align-items-center justify-content-between section-header">
        <span class="d-flex align-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-shield-fill-check" viewBox="0 0 16 16" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.8 11.8 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7 7 0 0 0 1.048-.625 11.8 11.8 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.54 1.54 0 0 0-1.044-1.263 63 63 0 0 0-2.887-.87C9.843.266 8.69 0 8 0m2.146 5.146a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793z"/>
            </svg>
            <span class="iv-ml-2">{{#str}}badges, block_rajabsgames{{/str}}</span>
        </span>
        <button class="btn btn-sm btn-light" id="add-badge" type="button" title="{{#str}}addbadge, block_rajabsgames{{/str}}">
            <i class="fa fa-plus iv-mr-2" aria-hidden="true"></i>{{#str}}addbadge, block_rajabsgames{{/str}}
        </button>
    </h5>
    {{#usedbadges}}
    <div class="alert alert-warning">
        <i class="fa fa-exclamation-triangle iv-mr-2" aria-hidden="true"></i>
        {{#str}}somebadgesareused, block_rajabsgames{{/str}}
    </div>
    {{/usedbadges}}
    <div role="list" class="rg_badges_list p-0 list-unstyled">
        {{< block_rajabsgames/badge}}{{$itemrole}}role="listitem"{{/itemrole}}{{/block_rajabsgames/badge}}
        {{^badges}}
        <div role="listitem" class="text-muted w-100 text-center my-5 empty-message">{{#str}}nobadges, block_rajabsgames{{/str}}</div>
        {{/badges}}
    </div>
</div>
</div>
{{#js}}
require(['block_rajabsgames/block_main'], function(blockMain) {
    blockMain.init(Number('{{blockid}}'), Number('{{contextid}}'), Number('{{courseid}}'), Number('{{userid}}'));
});
{{/js}}
