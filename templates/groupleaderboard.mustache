{{!
    @template block_rajabsgames/groupleaderboard

    The group leaderboard section of the course block: groups ranked by the XP their members earned.

    Context variables required for this template:
    * hasgroupleaderboard - whether the section is shown
    * gleaderboard - array of groups: rank, name, pictureurl, totalxp, mine (the viewer is a member)

    Example context (json):
    {
        "hasgroupleaderboard": true,
        "gleaderboard": [
            {"rank": 1, "name": "Group A", "pictureurl": "https://moodle.example/theme/image.php/boost/core/1/g/g1", "totalxp": 120, "mine": true},
            {"rank": 2, "name": "Group B", "pictureurl": "https://moodle.example/theme/image.php/boost/core/1/g/g1", "totalxp": 80, "mine": false}
        ]
    }
}}
{{#hasgroupleaderboard}}
<div class="rg_leaderboard">
    <h5 class="d-flex align-items-center justify-content-between section-header">
        <span class="rg_section_label iv-rounded-0 border-0 alert alert-danger m-0 text-danger">{{#str}}groupleaderboard, block_rajabsgames{{/str}}</span>
        <span class="rg_section_icon text-danger">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
            </svg>
        </span>
    </h5>
    <ul class="rg_leaderboard_list p-0">
        {{#gleaderboard}}
        <li class="rg_leaderboard_item d-flex align-items-center mb-2 iv-rounded-lg {{#mine}}active{{/mine}}{{^mine}}bg-light{{/mine}}">
            <h5 class="rg_leaderboard_rank {{^mine}}text-secondary{{/mine}}">{{rank}}</h5>
            <img src="{{pictureurl}}" class="rg_group_image iv-mr-2" alt="{{name}}" width="35" height="35" title="{{name}}">
            <div class="d-flex flex-column flex-grow-1 iv-mr-1">
                {{name}}
            </div>
            <div class="rg_leaderboard_xp iv-mr-2 iv-font-weight-bold text-nowrap">{{totalxp}} <sup>{{#str}}xp, block_rajabsgames{{/str}}</sup></div>
        </li>
        {{/gleaderboard}}
        {{^gleaderboard}}
        <li class="text-muted w-100 text-center my-5">{{#str}}nogroupleaderboard, block_rajabsgames{{/str}}</li>
        {{/gleaderboard}}
    </ul>
</div>
{{/hasgroupleaderboard}}
