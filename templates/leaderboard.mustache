{{!
    @template block_rajabsgames/leaderboard

    The user leaderboard section of the course block: the top learners by XP, with their level and groups.

    Context variables required for this template:
    * hasleaderboard - whether the section is shown
    * topthree - array of learners: rank, picture (trusted HTML from user_picture()), name, levelname,
      xp, isuser (the row is the viewer's), theirgroups (array of gname, gpictureurl)

    Example context (json):
    {
        "hasleaderboard": true,
        "topthree": [
            {
                "rank": 1,
                "picture": "<img src=\"https://moodle.example/theme/image.php/boost/core/1/u/f2\" class=\"userpicture\" width=\"35\" height=\"35\" alt=\"\">",
                "name": "Ana Souza",
                "levelname": "Expert",
                "xp": 120,
                "isuser": true,
                "theirgroups": [
                    {"gname": "Group A", "gpictureurl": "https://moodle.example/theme/image.php/boost/core/1/g/g1"}
                ]
            },
            {
                "rank": 2,
                "picture": "<img src=\"https://moodle.example/theme/image.php/boost/core/1/u/f2\" class=\"userpicture\" width=\"35\" height=\"35\" alt=\"\">",
                "name": "Bruno Lima",
                "levelname": "Beginner",
                "xp": 40,
                "isuser": false,
                "theirgroups": [
                    {"gname": "Group B", "gpictureurl": "https://moodle.example/theme/image.php/boost/core/1/g/g1"}
                ]
            }
        ]
    }
}}
{{#hasleaderboard}}
<div class="rg_leaderboard">
    <h5 class="text-info d-flex align-items-center justify-content-between section-header">
        <span class="rg_section_label iv-rounded-0 border-0 alert alert-info m-0 text-info">{{#str}}leaderboard, block_rajabsgames{{/str}}</span>
        <span class="rg_section_icon text-info">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trophy-fill" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M2.5.5A.5.5 0 0 1 3 0h10a.5.5 0 0 1 .5.5q0 .807-.034 1.536a3 3 0 1 1-1.133 5.89c-.79 1.865-1.878 2.777-2.833 3.011v2.173l1.425.356c.194.048.377.135.537.255L13.3 15.1a.5.5 0 0 1-.3.9H3a.5.5 0 0 1-.3-.9l1.838-1.379c.16-.12.343-.207.537-.255L6.5 13.11v-2.173c-.955-.234-2.043-1.146-2.833-3.012a3 3 0 1 1-1.132-5.89A33 33 0 0 1 2.5.5m.099 2.54a2 2 0 0 0 .72 3.935c-.333-1.05-.588-2.346-.72-3.935m10.083 3.935a2 2 0 0 0 .72-3.935c-.133 1.59-.388 2.885-.72 3.935"/>
            </svg>
        </span>
    </h5>
    <ul class="rg_leaderboard_list p-0">
        {{#topthree}}
        <li class="rg_leaderboard_item d-flex align-items-center mb-2 iv-rounded-lg {{#isuser}}active{{/isuser}}{{^isuser}}bg-light{{/isuser}}">
            <h5 class="rg_leaderboard_rank {{^isuser}}text-secondary{{/isuser}}">{{rank}}</h5>
            <div class="iv-mr-1">
                {{{picture}}}
            </div>
            <div class="d-flex flex-column flex-grow-1 iv-mr-1">
                <span class="rg_leaderboard_name d-flex align-items-center">{{name}} {{#theirgroups}}<img src="{{gpictureurl}}" class="rg_group_image iv-ml-2" alt="{{gname}}" width="15" height="15" title="{{gname}}">{{/theirgroups}}</span>
                {{#levelname}}
                <div class="rg_leaderboard_details text-muted small iv-font-weight-light">
                    <span class="rg_leaderboard_level iv-mr-2">{{levelname}}</span>
                </div>
                {{/levelname}}
            </div>
            <span class="rg_leaderboard_xp iv-mr-2 text-nowrap iv-font-weight-bold">{{xp}} <sup>{{#str}}xp, block_rajabsgames{{/str}}</sup></span>
        </li>
        {{/topthree}}
        {{^topthree}}
        <li class="text-muted w-100 text-center my-5">{{#str}}noleaderboard, block_rajabsgames{{/str}}</li>
        {{/topthree}}
    </ul>
</div>
{{/hasleaderboard}}
